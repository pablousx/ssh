#!/bin/sh
set -eu

case " $* " in
    *"https://github.com/pablousx/sshwitch/releases/latest"*)
        if [ -n "${MOCK_LATEST_TAG:-}" ]; then
            printf 'https://github.com/pablousx/sshwitch/releases/tag/%s' "$MOCK_LATEST_TAG"
            exit 0
        fi
        ;;
esac

if [ "${MOCK_CURL_FAILURE:-}" = "1" ]; then
    exit 22
fi

printf "Unexpected curl invocation in the test suite.\n" >&2
exit 1
